<div class="chat-page"
     data-controller="chat video-call"
     data-conversation-id="<%= @conversation.id %>"
     data-current-user-id="<%= current_user.id %>"
     data-current-user-name="<%= current_user.name %>"
     data-other-user-id="<%= @other_user.id %>"
     data-other-user-name="<%= @other_user.name %>">

  <div class="chat-container">

    <!-- Chat Header -->

    <div class="chat-header">

      <%= link_to "←",
                  conversations_path,
                  class: "back-chat" %>

      <div class="user-avatar">
        <%= @other_user.name.first.upcase %>
      </div>

      <div class="chat-user-info">

        <strong>
          <%= @other_user.name %>
        </strong>

        <span class="user-status online"
              data-chat-target="status"
              id="user-status-<%= @other_user.id %>">
          Online
        </span>

      </div>

      <div class="chat-header-actions">
        <button type="button"
          class="voice-call-header-btn"
          data-action="click->video-call#startVoiceCall"
          title="Start Voice Call">
          <svg xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="white">
            <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
          </svg>
        </button>
        <button type="button"
          class="video-call-header-btn"
          data-action="click->video-call#startCall"
          title="Start Video Call">
          <svg xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="white">
            <path d="M17 10.5V7c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2v-3.5l5 3v-7l-5 3z"/>
          </svg>
        </button>
      </div>

    </div>


    <!-- Messages -->

    <div class="messages-container"
         data-current-user-id="<%= current_user.id %>">

      <% if @messages.any? %>

        <% @messages.each do |message| %>

          <div class="message-row
                      <%= message.user == current_user ? "my-message" : "other-message" %>">

            <div class="message-bubble">

              <% if message.attachments.attached? %>
                <div class="message-attachments <%= "multiple" if message.attachments.count > 1 %>">
                  <% message.attachments.each do |att| %>
                    <% if att.image? %>
                      <%= image_tag att,
                            class: "chat-media-image",
                            data: {
                              action: "click->chat#openLightbox",
                              full_src: url_for(att)
                            },
                            alt: att.filename.to_s,
                            loading: "lazy" %>
                    <% elsif att.video? %>
                      <%= video_tag url_for(att),
                            controls: true,
                            playsinline: true,
                            preload: "metadata",
                            class: "chat-media-video" %>
                    <% end %>
                  <% end %>
                </div>
              <% end %>

              <% if message.content.present? %>
                <div class="message-content">
                  <%= message.content %>
                </div>
              <% end %>

              <small>
                <%= message.created_at.strftime("%I:%M %p") %>
              </small>

            </div>

          </div>

        <% end %>

      <% else %>

        <div class="empty-chat">

          <div class="empty-chat-icon">
            👋
          </div>

          <h3>
            Start the conversation
          </h3>

          <p>
            Send a message to <%= @other_user.name %>.
          </p>

        </div>

      <% end %>

    </div>


    <!-- Message Input -->

    <div class="message-input-area">

      <!-- Media Previews Strip -->
      <div class="media-preview-container" data-chat-target="mediaPreview" style="display: none;">
        <div class="preview-scroll-strip" data-chat-target="previewStrip"></div>
      </div>

      <!-- Multi-Category Emoji Picker Popup -->
      <div class="emoji-picker-container" data-chat-target="emojiPicker" style="display: none;">
        <div class="emoji-picker-header">
          <input type="text"
                 class="emoji-search-input"
                 placeholder="Search emojis..."
                 data-chat-target="emojiSearch"
                 data-action="input->chat#filterEmojis" />
          <button type="button"
                  class="emoji-picker-close-btn"
                  data-action="click->chat#closeEmojiPicker">✕</button>
        </div>
        <div class="emoji-category-tabs">
          <button type="button" class="category-tab active" data-action="click->chat#switchCategory" data-category="smileys" title="Smileys & Emotion">😀</button>
          <button type="button" class="category-tab" data-action="click->chat#switchCategory" data-category="gestures" title="People & Gestures">👍</button>
          <button type="button" class="category-tab" data-action="click->chat#switchCategory" data-category="hearts" title="Hearts & Love">❤️</button>
          <button type="button" class="category-tab" data-action="click->chat#switchCategory" data-category="celebration" title="Celebration & Fun">🎉</button>
          <button type="button" class="category-tab" data-action="click->chat#switchCategory" data-category="objects" title="Objects & Symbols">💡</button>
        </div>
        <div class="emoji-grid-wrapper" data-chat-target="emojiGrid"></div>
      </div>

      <%= form_with model: [@conversation, @message],
                    class: "message-form",
                    multipart: true,
                    data: {
                      action: "submit->chat#handleSubmit",
                      chat_target: "form"
                    } do |form| %>

        <!-- Hidden File Input for Multiple Images / Videos -->
        <%= form.file_field :attachments,
              multiple: true,
              accept: "image/*,video/*",
              class: "hidden-file-input",
              style: "display: none;",
              data: {
                chat_target: "fileInput",
                action: "change->chat#handleFileSelect"
              } %>

        <!-- Attachment Button -->
        <button type="button"
                class="attach-button"
                data-chat-target="attachBtn"
                data-action="click->chat#triggerFileInput"
                title="Attach Images or Videos">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
            <path d="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5a2.5 2.5 0 0 1 5 0v10.5c0 .83-.67 1.5-1.5 1.5s-1.5-.67-1.5-1.5V6H9v9.5a3 3 0 0 0 6 0V5a4 4 0 0 0-8 0v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z"/>
          </svg>
        </button>

        <%= form.text_field :content,
              placeholder: "Write a message...",
              autocomplete: "off",
              class: "message-input",
              data: {
                chat_target: "input",
                action: "input->chat#handleInput"
              } %>

        <!-- Emoji Button -->
        <button type="button"
                class="emoji-button"
                data-chat-target="emojiBtn"
                data-action="click->chat#toggleEmojiPicker"
                title="Choose Emoji">
          😊
        </button>

        <%= form.submit "➤",
              class: "send-button" %>

      <% end %>

    </div>

  </div>

  <!-- Video Call Modal & Overlays -->
  <div class="video-call-modal-backdrop"
       data-video-call-target="modal"
       style="display: none;">

    <div class="video-call-container">

      <!-- Incoming Call Card -->
      <div class="video-call-card incoming-card"
           data-video-call-target="incomingModal"
           style="display: none;">
        <div class="call-avatar pulsing" data-video-call-target="incomingAvatar">
          <%= @other_user.name.first.upcase %>
        </div>
        <h3 class="caller-title" data-video-call-target="incomingCallTitle">
          Incoming Video Call
        </h3>
        <p class="caller-subtitle">
          <span data-video-call-target="incomingCallerName"><%= @other_user.name %></span> is calling you...
        </p>
        <div class="call-actions">
          <button type="button"
                  class="btn-call accept-btn"
                  data-action="click->video-call#acceptIncomingCall">
            📞 Accept
          </button>
          <button type="button"
                  class="btn-call reject-btn"
                  data-action="click->video-call#rejectIncomingCall">
            ❌ Decline
          </button>
        </div>
      </div>

      <!-- Outgoing Call Card -->
      <div class="video-call-card outgoing-card"
           data-video-call-target="outgoingModal"
           style="display: none;">
        <div class="call-avatar pulsing" data-video-call-target="outgoingAvatar">
          <%= @other_user.name.first.upcase %>
        </div>
        <h3 class="caller-title" data-video-call-target="outgoingCallTitle">
          Calling...
        </h3>
        <p class="caller-subtitle">
          Waiting for <span data-video-call-target="callerName"><%= @other_user.name %></span> to answer...
        </p>
        <div class="call-actions">
          <button type="button"
                  class="btn-call end-btn"
                  data-action="click->video-call#endCall">
            ❌ Cancel
          </button>
        </div>
      </div>

      <!-- Active Video Call View -->
      <div class="video-call-active-window"
           data-video-call-target="activeModal"
           style="display: none;">

        <div class="video-call-header-overlay" data-video-call-target="headerOverlay">
          <div class="status-info">
            <span class="status-badge" data-video-call-target="callStatus">Connecting...</span>
            <span class="timer-badge" data-video-call-target="callTimer">00:00</span>
          </div>
        </div>

        <!-- Voice Call Active Card (shown instead of video feeds during voice calls) -->
        <div class="voice-call-active-card"
             data-video-call-target="voiceCallCard"
             style="display: none;">
          <div class="voice-avatar-ring">
            <div class="call-avatar voice-call-avatar">
              <span data-video-call-target="remoteAvatarInitial"><%= @other_user.name.first.upcase %></span>
            </div>
          </div>
          <h3 class="voice-caller-name"><%= @other_user.name %></h3>
          <span class="status-badge voice-status" data-video-call-target="callStatus">Connecting...</span>
          <span class="timer-badge voice-timer" data-video-call-target="callTimer">00:00</span>
        </div>

        <!-- Dedicated Remote Audio Player for Voice Calls -->
        <audio data-video-call-target="remoteAudio" autoplay playsinline style="display: none;"></audio>

        <!-- Video Feeds (hidden during voice calls) -->
        <div class="video-feed-wrapper" data-video-call-target="videoFeedWrapper">
          <video data-video-call-target="remoteVideo"
                 autoplay
                 playsinline
                 class="remote-video-feed"></video>

          <!-- Remote Status Indicators -->
          <div class="remote-status-overlay">
            <span class="remote-badge remote-muted-badge"
                  data-video-call-target="remoteMutedBadge"
                  style="display: none;">
              🎙️ Muted
            </span>
          </div>

          <!-- Remote Camera Off Overlay -->
          <div class="remote-camera-off-overlay"
               data-video-call-target="remoteCameraOffOverlay"
               style="display: none;">
            <div class="call-avatar">
              <span><%= @other_user.name.first.upcase %></span>
            </div>
            <p>Camera is turned off</p>
          </div>

          <video data-video-call-target="localVideo"
                 autoplay
                 playsinline
                 muted
                 class="local-video-feed"></video>
        </div>

        <!-- Control Bar -->
        <div class="video-controls-bar">
          <button type="button"
                  class="control-btn toggle-audio"
                  data-video-call-target="audioBtn"
                  data-action="click->video-call#toggleAudio">
            🎙️ On
          </button>
          <span data-video-call-target="videoBtnWrapper">
            <button type="button"
                    class="control-btn toggle-video"
                    data-video-call-target="videoBtn"
                    data-action="click->video-call#toggleVideo">
              📹 On
            </button>
          </span>
          <button type="button"
                  class="control-btn end-call-btn"
                  data-action="click->video-call#endCall">
            📞 End Call
          </button>
        </div>

      </div>

    </div>
  <!-- Lightbox Modal for Full-Size Image Preview -->
  <div class="chat-lightbox-modal"
       data-chat-target="lightbox"
       style="display: none;"
       data-action="click->chat#closeLightboxOnBackdrop">
    <div class="lightbox-content">
      <button type="button"
              class="lightbox-close-btn"
              data-action="click->chat#closeLightbox">×</button>
      <img src=""
           alt="Full Preview"
           class="lightbox-image"
           data-chat-target="lightboxImg" />
    </div>
  </div>

</div>
